# ClickHouse - Capa Analítica (OLAP)
CLICKHOUSE_DB=urbanbike
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=secret_clickhouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123

# PocketBase - Capa Operativa (OLTP)
PB_SUPERUSER_EMAIL=admin@urbanbike.com
PB_SUPERUSER_PASSWORD=secret_pocketbase
PB_URL=http://localhost:8090

# FastAPI Sessions
# Obligatoria: la app no arranca si falta. Genera una real, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-en-produccion

# "production" activa el flag Secure de la cookie de sesion (requiere HTTPS).
# Cualquier otro valor (o dejarla sin definir) se trata como desarrollo local.
ENVIRONMENT=development

# Airflow - Orquestacion del ETL real (etl/07, 08, 09), cada 1 hora
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambia-esto-en-produccion

# SMTP - Correo real del código de verificación en el registro público
# (ver app/email_client.py). Best-effort: si falta, la cuenta igual se
# crea, solo no llega el código (se puede reenviar despues). Funciona
# igual con Gmail o con Brevo (SMTP relay), solo cambian los valores:
#
# Gmail:  SMTP_HOST=smtp.gmail.com, SMTP_USER=tu-correo@gmail.com,
#         SMTP_APP_PASSWORD = contraseña de aplicación
#         (myaccount.google.com/apppasswords), NUNCA la contraseña normal.
# Brevo:  SMTP_HOST=smtp-relay.brevo.com, SMTP_USER/SMTP_APP_PASSWORD =
#         credenciales SMTP de Brevo (no son un correo real) --
#         SMTP_FROM_EMAIL debe ser un remitente verificado en Brevo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=UrbanBike
SMTP_FROM_EMAIL=tu-correo@gmail.com

# Correo de soporte mostrado en /auth/bloqueado, factura y pantallas de
# soporte del ciclista (ver app/config.py) -- deliberadamente distinto de
# SMTP_FROM_EMAIL, que es el remitente transaccional ("no respondas a
# este mensaje"), no una casilla real de soporte. Bug real corregido el
# 16-ago-2026 (ver docs/HOJA_DE_RUTA.md sección 68): este valor había
# quedado igual a SMTP_FROM_EMAIL por error, contradiciendo el propio
# comentario de arriba.
SUPPORT_EMAIL=soporte@urbanbike.com
